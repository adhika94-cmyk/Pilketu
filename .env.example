# ==========================================
# Konfigurasi Server Localhost & Supabase eOSIS
# ==========================================

# Port & Host Server Localhost (Default: 3000)
PORT=3000
HOST=0.0.0.0

# URL dan Anon Public Key Supabase (Opsional - Jika menggunakan Supabase Cloud/Self-hosted)
# Jika dikosongkan, aplikasi eOSIS otomatis berjalan dengan sistem Penyimpanan Lokal (Fallback Mode)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-actual-anon-public-key
